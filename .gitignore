# ── Home Assistant config (tracked separately) ────────────
configuration.yaml
automations.yaml
scenes.yaml
scripts.yaml
blueprints/
themes/
.HA_VERSION

# ── Home Assistant runtime (never commit) ──────────────────
*.db
*.db-shm
*.db-wal
*.log
*.log.*
secrets.yaml
deps/
tts/
venv/
.venv/
.storage/
.cache/
__pycache__/
*.pyc

# ── Backup copies ──────────────────────────────────────────
custom_components/selora_backup/

# ── Archives ───────────────────────────────────────────────
*.zip

# ── Claude Code local settings ─────────────────────────────
.claude/settings.local.json

# ── Secrets ─────────────────────────────────────────────────
.env

# ── OS / IDE ───────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
.ha_run.lock
.python-version
requirements.txt
AGENTS.md

# ── Local dependency manifest overrides ─────────────────────
requirements.txt

# ── Frontend build artifacts ──────────────────────────────────
node_modules/
# Built by `just build` (and by the release job before it zips), never committed:
# a committed bundle made every frontend MR conflict with the next one merged.
custom_components/selora_ai/frontend/panel.js
custom_components/selora_ai/frontend/panel.build.json
custom_components/selora_ai/frontend/card.js
custom_components/selora_ai/frontend/.vitest/

# ── Local dev scripts ─────────────────────────────────────────
/scripts/
.hassfest_tmp/
.commitlint_msg

# uv test-env lockfile (deps come from manifest.json, not tracked)
uv.lock
